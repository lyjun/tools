{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Artifact",
      "Bash(claude mcp *)",
      "Bash(devcontainer exec *)",
      "Bash(docker cp *)",
      "Bash(docker exec *)",
      "Bash(docker rm *)",
      "Bash(echo *)",
      "Bash(gh api *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh repo view *)",
      "Bash(git *)",
      "Bash(grep *)",
      "Bash(mkdir *)",
      "Bash(multipass exec *)",
      "Bash(multipass list *)",
      "Bash(multipass transfer *)",
      "Bash(python3 *)",
      "Bash(shasum *)",
      "Bash(sshpass *)",
      "Read(//Users/yijyun/**)",
      "Read(//private/tmp/**)",
      "Skill",
      "WebFetch",
      "WebSearch",
      "mcp__chrome-devtools__click",
      "mcp__chrome-devtools__fill",
      "mcp__chrome-devtools__list_console_messages",
      "mcp__chrome-devtools__list_network_requests",
      "mcp__chrome-devtools__list_pages",
      "mcp__chrome-devtools__new_page",
      "mcp__chrome-devtools__take_screenshot",
      "mcp__chrome-devtools__take_snapshot",
      "mcp__chrome-devtools__wait_for",
      "mcp__claude_ai_Claude_Docs__batch",
      "mcp__claude_ai_Claude_Docs__guide",
      "mcp__claude_ai_Claude_Docs__read",
      "mcp__claude_ai_Claude_Docs__update"
    ],
    "deny": [
      "Bash(chflags *)",
      "Bash(chgrp *)",
      "Bash(chown *)",
      "Bash(codesign *)",
      "Bash(csrutil *)",
      "Bash(dd *)",
      "Bash(diskutil erase*)",
      "Bash(diskutil partitionDisk *)",
      "Bash(dscl *)",
      "Bash(fdesetup *)",
      "Bash(fdisk *)",
      "Bash(halt *)",
      "Bash(launchctl *)",
      "Bash(networksetup *)",
      "Bash(nvram *)",
      "Bash(passwd *)",
      "Bash(pmset *)",
      "Bash(reboot *)",
      "Bash(rm -rf /)",
      "Bash(scutil *)",
      "Bash(security *)",
      "Bash(shutdown *)",
      "Bash(softwareupdate *)",
      "Bash(spctl *)",
      "Bash(systemsetup *)",
      "Bash(tmutil *)",
      "Edit(//Users/yijyun/.gnupg/**)",
      "Edit(//Users/yijyun/.ssh/**)"
    ],
    "ask": [
      "Bash(brew install *)",
      "Bash(brew uninstall *)",
      "Bash(crontab *)",
      "Bash(gem install *)",
      "Bash(npm install -g *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(rm -rf /*)",
      "Bash(sudo:*)"
    ],
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "/Users/yijyun/.claude",
      "/Users/yijyun/Desktop/Workspace/ardge"
    ]
  },
  "fallbackModel": [
    "claude-opus-4-7",
    "claude-sonnet-4-6"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/git-branch-naming.sh",
            "if": "Bash(git *)",
            "timeout": 5,
            "statusMessage": "Checking branch naming..."
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/bash-shape-gate.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "bashEditDiffEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh",
    "padding": 0
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "~/.claude/subagent-statusline-command.sh"
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": false,
    "frontend-design@anthropic-plugin-directory": false
  },
  "outputStyle": "Plain report",
  "language": "繁體中文",
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "opus",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "stable",
  "minimumVersion": "2.1.245",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "verbose": false,
  "preferredNotifChannel": "ghostty",
  "autoCompactEnabled": true,
  "autoScrollEnabled": true,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": false,
  "useAutoModeDuringPlan": false,
  "voiceEnabled": false
}
